{
  // ── .devcontainer/devcontainer.json ────────────────────────────────────────
  // GitHub Codespaces reads this file to configure the dev environment.
  // On launch it builds docker-compose.yml and forwards all service ports.
  // ──────────────────────────────────────────────────────────────────────────

  "name": "ML Monitoring Pipeline",

  // Use docker-compose as the environment (not a single Dockerfile)
  "dockerComposeFile": ["../docker-compose.yml"],

  // Must match the service name in docker-compose.yml exactly
  "service": "ml_api",

  // Matches WORKDIR in Dockerfile.api
  "workspaceFolder": "/app",

  // ── Port forwarding ────────────────────────────────────────────────────────
  // Codespaces auto-generates public HTTPS URLs for each forwarded port.
  "forwardPorts": [
    8000,   // FastAPI
    9100,   // Prometheus exporter (ml_api second port)
    8080,   // Airflow Webserver
    9090,   // Prometheus
    3000,   // Grafana
    5432,   // Postgres
    9101,   // Node Exporter
    8081    // cAdvisor
  ],

  // Human-readable labels shown in the Ports tab
  "portsAttributes": {
    "8000": { "label": "FastAPI",          "onAutoForward": "notify" },
    "9100": { "label": "Prom Exporter",    "onAutoForward": "silent" },
    "8080": { "label": "Airflow",          "onAutoForward": "notify" },
    "9090": { "label": "Prometheus",       "onAutoForward": "silent" },
    "3000": { "label": "Grafana",          "onAutoForward": "notify" },
    "5432": { "label": "Postgres",         "onAutoForward": "silent" },
    "9101": { "label": "Node Exporter",    "onAutoForward": "silent" },
    "8081": { "label": "cAdvisor",         "onAutoForward": "silent" }
  },

  // ── Extensions installed automatically ────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-azuretools.vscode-docker",
        "rangav.vscode-thunder-client",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        }
      }
    }
  },

  // postCreateCommand runs on the HOST side after containers start —
  // correct place for health-check polling and setup scripts
  "postCreateCommand": "bash .devcontainer/post-start.sh"
}