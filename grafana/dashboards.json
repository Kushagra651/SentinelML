{
  "uid": "ml-monitoring-main",
  "title": "SentinelML Monitoring",
  "tags": ["ml", "monitoring"],
  "timezone": "utc",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Predictions",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "ml_api_requests_total", "legendFormat": "total"}]
    },
    {
      "id": 2, "type": "stat", "title": "Request Rate (req/s)",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "ml_api_request_rate_per_sec", "legendFormat": "req/s"}]
    },
    {
      "id": 3, "type": "stat", "title": "Error Rate (req/s)",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "ml_api_error_rate_per_sec", "legendFormat": "err/s"}]
    },
    {
      "id": 4, "type": "stat", "title": "Mean Confidence",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "ml_api_confidence_sum / ml_api_confidence_count", "legendFormat": "confidence"}]
    },
    {
      "id": 5, "type": "stat", "title": "Drift Detected",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "ml_monitor_drift_overall", "legendFormat": "drift"}]
    },
    {
      "id": 6, "type": "stat", "title": "Quality Passed",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "ml_monitor_quality_overall_passed", "legendFormat": "quality"}]
    },
    {
      "id": 7, "type": "graph", "title": "p99 Latency (ms)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "histogram_quantile(0.99, rate(ml_api_latency_ms_bucket[5m]))", "legendFormat": "p99"}]
    },
    {
      "id": 8, "type": "graph", "title": "Predictions by Class",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"datasource": {"uid": "prometheus"}, "expr": "ml_api_predictions_class_0_total", "legendFormat": "<=50K"},
        {"datasource": {"uid": "prometheus"}, "expr": "ml_api_predictions_class_1_total", "legendFormat": ">50K"}
      ]
    },
    {
      "id": 9, "type": "graph", "title": "Feature PSI Scores",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "ml_monitor_drift_feature_psi", "legendFormat": "{{feature}} ({{severity}})"}]
    },
    {
      "id": 10, "type": "graph", "title": "Requests by Model Version",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "ml_api_requests_by_version_total", "legendFormat": "{{model_version}}"}]
    },
    {
      "id": 11, "type": "graph", "title": "Feature Missing Rate (%)",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "ml_monitor_quality_feature_missing_pct", "legendFormat": "{{feature}}"}]
    }
  ]
}