# =============================================================================
# .env.example
# Copy to .env and fill in real values. Never commit .env to git.
# cp .env.example .env
# =============================================================================

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production                   # production | staging | development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=ml_postgres
POSTGRES_PORT=5432
POSTGRES_USER=mluser
POSTGRES_PASSWORD=mlpassword
POSTGRES_DB=ml_monitoring
POSTGRES_AIRFLOW_DB=airflow

# ── ML API ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=2

# ── Artifact paths (inside containers) ────────────────────────────────────────
ARTIFACTS_DIR=/app/artifacts
MODEL_DIR=/app/artifacts/models

# ── Model training ────────────────────────────────────────────────────────────
TARGET_COLUMN=income
RANDOM_SEED=42
TRAIN_VAL_SPLIT=0.2
MIN_TRAIN_ACCURACY=0.5
TRAINING_DATA_SOURCE=db                  # db | csv
AUTO_PROMOTE=false

# GBM hyperparameters
GBM_N_ESTIMATORS=200
GBM_MAX_DEPTH=4
GBM_LEARNING_RATE=0.05
GBM_SUBSAMPLE=0.8

# ── Model evaluation / promotion thresholds ───────────────────────────────────
EVAL_MIN_ACCURACY=0.75
EVAL_MIN_F1=0.70
EVAL_MIN_ROC_AUC=0.75
DECISION_THRESHOLD=0.5
MIN_IMPROVEMENT_DELTA=0.001

# ── Prometheus exporter ───────────────────────────────────────────────────────
EXPORTER_PORT=9100
SCRAPE_INTERVAL_SEC=30
METRICS_NAMESPACE=ml_monitor

# ── DAG schedules (cron) ──────────────────────────────────────────────────────
TRAINING_SCHEDULE=0 2 * * 0             # weekly Sunday 02:00
DRIFT_CHECK_SCHEDULE=0 */6 * * *        # every 6 hours
RETRAIN_TRIGGER_SCHEDULE=30 */6 * * *   # 30 min after drift check

# ── Drift detection thresholds ────────────────────────────────────────────────
DRIFT_WINDOW_HOURS=6
DRIFT_MIN_SAMPLES=30
KS_P_THRESHOLD=0.05
CHI2_P_THRESHOLD=0.05
PSI_WARNING=0.1
PSI_CRITICAL=0.2
PSI_BINS=10

# ── Quality check thresholds ──────────────────────────────────────────────────
MISSING_WARN_PCT=0.05
MISSING_CRITICAL_PCT=0.15
OOR_CRITICAL_PCT=0.10
UNKNOWN_CAT_PCT=0.05
CONFIDENCE_LOW_WARN=0.55

# ── Retrain trigger ───────────────────────────────────────────────────────────
RETRAIN_COOLDOWN_HOURS=12
RETRAIN_MAX_PER_DAY=2
RETRAIN_AUTO_PROMOTE=false

# ── Prediction logging ────────────────────────────────────────────────────────
LOG_BUFFER_SIZE=500
LOG_FLUSH_INTERVAL_SEC=30
LOG_JSONL_PATH=/app/artifacts/logs
LOG_LEVEL=info

# ── Airflow ───────────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: changing after airflow db init breaks all stored connections/variables
AIRFLOW_FERNET_KEY=your-generated-fernet-key-here
AIRFLOW_SECRET_KEY=your-airflow-secret-key-here
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Alerting (leave blank to disable that channel) ────────────────────────────
ALERT_DEDUP_WINDOW_SEC=300
ALERT_HTTP_TIMEOUT_SEC=10

# Slack
SLACK_WEBHOOK_URL=

# PagerDuty (Events API v2)
PAGERDUTY_ROUTING_KEY=

# Generic webhook (optional)
ALERT_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ── Agent ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
AGENT_MODEL=llama-3.1-8b-instant
AGENT_API_BASE=http://ml_api:8000       # internal Docker network URL
AGENT_MAX_TOKENS=1024
AGENT_TEMPERATURE=0.1

# ── Streamlit ─────────────────────────────────────────────────────────────────
STREAMLIT_API_BASE=http://localhost:8000  # host-accessible URL for browser requests
STREAMLIT_PORT=8501