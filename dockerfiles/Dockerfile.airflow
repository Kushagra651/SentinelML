FROM apache/airflow:2.9.1-python3.11

USER airflow
RUN pip install --no-cache-dir \
        scikit-learn \
        pandas \
        numpy \
        scipy \
        psycopg2-binary \
        pyarrow \
        fastparquet

USER root
COPY api/          ${AIRFLOW_HOME}/project/api/
COPY data/         ${AIRFLOW_HOME}/project/data/
COPY training/     ${AIRFLOW_HOME}/project/training/
COPY monitoring/   ${AIRFLOW_HOME}/project/monitoring/
COPY alerting/     ${AIRFLOW_HOME}/project/alerting/
COPY airflow/dags/ ${AIRFLOW_HOME}/dags/

RUN touch ${AIRFLOW_HOME}/project/api/__init__.py \
          ${AIRFLOW_HOME}/project/data/__init__.py \
          ${AIRFLOW_HOME}/project/training/__init__.py \
          ${AIRFLOW_HOME}/project/monitoring/__init__.py \
          ${AIRFLOW_HOME}/project/alerting/__init__.py && \
    chown -R airflow:root ${AIRFLOW_HOME}/project ${AIRFLOW_HOME}/dags

USER airflow

ENV PYTHONPATH="${AIRFLOW_HOME}/project:${PYTHONPATH}"