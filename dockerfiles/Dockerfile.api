# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# Flaky-network tolerant: long timeout, many retries, wheel cache kept across builds.
# (pip self-upgrade removed: it was an extra download that could fail the whole build.)
ENV PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install build deps separately so this layer is cached unless requirements change
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --prefix=/install -r requirements.txt


# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

# Non-root user — matches chown commands in project_context.md
RUN groupadd -r mluser && useradd -r -g mluser -d /app mluser

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source
COPY api/        ./api/
COPY data/       ./data/
COPY training/   ./training/
COPY monitoring/ ./monitoring/
COPY alerting/   ./alerting/
COPY agent/ /app/agent/
COPY experiments/ /app/experiments/

# Artifacts dir created here; actual artifacts mounted/copied at runtime
RUN mkdir -p artifacts/models artifacts/drift_reports artifacts/quality_reports \
             artifacts/logs artifacts/feature_store && \
    chown -R mluser:mluser /app

USER mluser

# Expose API port + Prometheus exporter port
EXPOSE 8000 9100

# Start both uvicorn (API) and prometheus_exporter in the same container.
# Exporter runs as a daemon thread inside the same Python process via main.py startup,
# OR as a background process here. We use a shell wrapper so both get proper signals.
CMD ["sh", "-c", \
     "python -m monitoring.prometheus_exporter & \
      uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 1 --log-level info"]